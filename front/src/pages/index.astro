      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730048976/genshin/hfxywc5baa5bahqtoq9r.webp",
    path: "/nations/mondstadt",
  },
  {
    name: "Liyue",
    background:
      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730050282/genshin/qoibknurvp6oi0k5mwyz.webp",
    backgroundChar:
      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730050282/genshin/lctvltapip84pjf5a6bl.webp",
    path: "/nations/liyue",
  },
  {
    name: "Inazuma",
    background:
      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730050282/genshin/a3qqnhqvwhrmiok5ojpu.webp",
    backgroundChar:
      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730050282/genshin/sebq1qpcz6wkmwfa81i9.webp",
    path: "/nations/inazuma",
  },
  {
    name: "Sumeru",
    background:
      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730050282/genshin/zkm8dnjvpusdfjxg8w5e.webp",
    backgroundChar:
      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730050282/genshin/hprjxvldzxheehuikctg.webp",
    path: "/nations/sumeru",
  },
  {
    name: "Fontaine",
    background:
      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730050282/genshin/vinxvmssc0sm0ze0lqsp.webp",
    backgroundChar:
      "https://res.cloudinary.com/dbcqkm8yz/image/upload/v1730050282/genshin/eodbcbbvpzmrur27yw73.webp",
    path: "/nations/fontaine",
  },
  {
    name: "Natlan",
    background:
