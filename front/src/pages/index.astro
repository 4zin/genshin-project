---

<Layout title="Home">
  <!-- <a href="/create">Create</a> -->
  <ul>
    {
      nationSource.map((nation) => (
        <HomeNations
          key={nation.name}
          name={nation.name}
          background={nation.background}
          backgroundChar={nation.backgroundChar}
          path={nation.path}
        />
      ))
    }
  </ul>
</Layout>
